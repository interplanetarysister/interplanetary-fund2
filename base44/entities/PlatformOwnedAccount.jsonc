{
  "name": "PlatformOwnedAccount",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "profile_url": {
      "type": "string"
    },
    "profile_description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "approval_needed",
        "setup_in_progress",
        "active",
        "needs_attention",
        "retired"
      ],
      "default": "planned"
    },
    "connection_id": {
      "type": "string"
    },
    "credential_reference": {
      "type": "string",
      "description": "Reference to secure credential storage only. Never store a raw password or token here."
    },
    "recovery_status": {
      "type": "string"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "weekly_post_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "discovered_by": {
      "type": "string",
      "default": "outreach"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}