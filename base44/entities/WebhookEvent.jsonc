{
  "name": "WebhookEvent",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "description": "Provider, e.g. 'kofi', 'stripe'."
    },
    "event_key": {
      "type": "string",
      "description": "Deterministic dedupe key for the event (provider id or hash of stable fields)."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source",
    "event_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}