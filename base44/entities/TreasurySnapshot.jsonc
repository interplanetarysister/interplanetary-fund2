{
  "name": "TreasurySnapshot",
  "type": "object",
  "properties": {
    "total_raised": {
      "type": "number"
    },
    "total_held": {
      "type": "number"
    },
    "total_fees": {
      "type": "number"
    },
    "net_position": {
      "type": "number"
    },
    "campaign_totals": {
      "type": "array",
      "description": "Per-campaign balances from the Convex treasury aggregate.",
      "items": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "string"
          },
          "raised": {
            "type": "number"
          },
          "held": {
            "type": "number"
          },
          "fees": {
            "type": "number"
          }
        }
      }
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}