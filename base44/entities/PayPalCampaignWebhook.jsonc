{
  "name": "PayPalCampaignWebhook",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "account_ref": {
      "type": "string"
    },
    "webhook_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": "string",
      "enum": [
        "live",
        "sandbox"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider",
    "account_ref",
    "webhook_id",
    "url",
    "environment"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "description": "Registered PayPal campaign-payment webhook, independently verified against the designated business REST application. Not a donation ledger; server-side webhook signature required."
}