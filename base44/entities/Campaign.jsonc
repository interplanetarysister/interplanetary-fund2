{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "story": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "medical",
        "emergency",
        "education",
        "community",
        "animals",
        "business",
        "memorial",
        "disaster_relief",
        "creative",
        "other"
      ],
      "default": "other"
    },
    "goal_amount": {
      "type": "number",
      "minimum": 1
    },
    "raised_amount": {
      "type": "number",
      "default": 0
    },
    "donor_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed"
      ],
      "default": "active"
    },
    "cover_image_url": {
      "type": "string"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string",
      "description": "The city where this campaign is based, so it can appear on the global activity globe."
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "cashapp_tag": {
      "type": "string"
    },
    "ai_profile": {
      "type": "object",
      "properties": {
        "primary_goal": {
          "type": "string"
        },
        "who_helping": {
          "type": "string"
        },
        "ideal_donors": {
          "type": "string",
          "description": "Optional creator hypothesis about likely supporters. AI audience discovery must not treat this as a fixed targeting constraint."
        },
        "donor_discovery_mode": {
          "type": "string",
          "enum": [
            "ai_research",
            "creator_guided"
          ],
          "default": "ai_research"
        },
        "donor_discovery_notes": {
          "type": "string"
        },
        "tone": {
          "type": "string"
        },
        "never_change": {
          "type": "string"
        },
        "always_emphasize": {
          "type": "string"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interested_orgs": {
          "type": "string"
        },
        "avoid_words": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "long_term_outcome": {
          "type": "string"
        }
      }
    },
    "story_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "seo": {
            "type": "boolean"
          },
          "accessibility": {
            "type": "boolean"
          },
          "created_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "outreach_enabled": {
      "type": "boolean",
      "default": true
    },
    "outreach_paused": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "goal_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": {
            "$ne": "draft"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "Campaign"
}