{
  "name": "Message",
  "type": "object",
  "properties": {
    "campaign_id": { "type": "string" },
    "campaign_title": { "type": "string" },
    "subject": { "type": "string" },
    "content": { "type": "string" },
    "comm_type": {
      "type": "string",
      "enum": ["update", "thank_you", "announcement", "milestone", "volunteer", "sponsor"],
      "default": "update"
    },
    "audience": {
      "type": "string",
      "enum": ["campaign_donors", "all_donors", "recurring_donors"],
      "default": "campaign_donors"
    },
    "channels": {
      "type": "array",
      "items": { "type": "string", "enum": ["email", "in_app"] }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "sent", "partial", "failed"],
      "default": "sent",
      "description": "Delivery outcome: sent when all requested channels succeeded, partial when at least one requested delivery path failed, failed when no requested delivery path succeeded."
    },
    "sent_at": { "type": "string", "format": "date-time" },
    "recipient_count": { "type": "number", "default": 0 },
    "email_count": { "type": "number", "default": 0 },
    "in_app_count": { "type": "number", "default": 0 },
    "email_failure_count": { "type": "number", "default": 0 },
    "delivery_error": { "type": "string" },
    "ai_generated": { "type": "boolean", "default": false }
  },
  "required": ["subject", "content"],
  "rls": {
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}