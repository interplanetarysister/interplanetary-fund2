{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "neighborhood",
        "city",
        "school",
        "faith",
        "volunteer",
        "business",
        "organization",
        "professional",
        "interest",
        "emergency",
        "other"
      ],
      "default": "interest"
    },
    "location": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name"
  ]
}