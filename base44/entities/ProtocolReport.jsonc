{
  "name": "ProtocolReport",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Convex report id \u2014 the sync match key."
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "passed_count": {
      "type": "number"
    },
    "failed_count": {
      "type": "number"
    },
    "results": {
      "type": "array",
      "description": "Per-campaign protocol check results as reported by Convex.",
      "items": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "string"
          },
          "standard": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "report_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}