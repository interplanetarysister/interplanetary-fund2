{
  "name": "ExternalSyncClaim",
  "type": "object",
  "description": "Immutable atomic claim for one bounded request-triggered external fundraising provider job.",
  "properties": {
    "claim_key": {
      "type": "string",
      "description": "Unique request-attempt key or deterministic per-window rate-slot key; used as the atomic upsert key."
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "request_attempt",
        "rate_slot"
      ],
      "description": "Optional for legacy rows; distinguishes request execution claims from atomic rate-limit slots."
    },
    "rate_window_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "rate_slot": {
      "type": "number"
    },
    "request_key": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "external_funds",
        "campaign_discovery",
        "campaign_import",
        "imported_campaign_refresh"
      ]
    },
    "actor_user_id": {
      "type": "string"
    },
    "attempt_number": {
      "type": "number"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "claim_key",
    "request_key",
    "request_id",
    "job_type",
    "actor_user_id",
    "attempt_number",
    "claimed_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}