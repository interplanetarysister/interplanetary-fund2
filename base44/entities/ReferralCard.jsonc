{
  "name": "ReferralCard",
  "type": "object",
  "description": "One individually issued IFund business card referral. Only administrators or previously referred members with provider-verified, active paid subscriptions may issue cards. A code is non-expiring until claimed or revoked, and is redeemable once.",
  "properties": {
    "code": {
      "type": "string",
      "description": "Cryptographically random code carried in the card's first-party homepage QR URL."
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "redeemed",
        "revoked"
      ],
      "default": "available"
    },
    "issued_by_user_id": {
      "type": "string",
      "description": "IFund account that issued this unique card. Ordinary users cannot read private referral records."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "redeemed_by_user_id": {
      "type": "string"
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reward_tier": {
      "type": "string",
      "enum": [
        "enterprise"
      ],
      "default": "enterprise"
    },
    "reward_days": {
      "type": "number",
      "default": 30
    },
    "card_label": {
      "type": "string"
    },
    "parent_referral_code": {
      "type": "string",
      "description": "If issued by a referred paying member, the code that first brought that member to IFund. Attribution only; no financial or multilevel payout."
    }
  },
  "required": [
    "code",
    "status",
    "issued_by_user_id",
    "issued_at",
    "reward_tier",
    "reward_days"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
