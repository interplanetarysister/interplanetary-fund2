{
  "name": "DiscussionPost",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "announcement",
        "question",
        "idea",
        "success_story",
        "coordination",
        "support"
      ],
      "default": "question"
    },
    "author_name": {
      "type": "string"
    },
    "reply_count": {
      "type": "number",
      "default": 0
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "community_id",
    "title"
  ]
}