{
  "name": "Donation",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "donor_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ]
    }
  },
  "required": [
    "campaign_id",
    "amount"
  ]
}