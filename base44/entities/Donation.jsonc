{
  "name": "Donation",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "donor_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ]
    },
    "donor_user_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "cashapp",
        "stripe",
        "other"
      ],
      "default": "paypal",
      "description": "How the supporter sent their gift."
    },
    "withdrawal_id": {
      "type": "string",
      "description": "Set to the Withdrawal id once these funds have been cashed out. Null means the funds are still available to withdraw."
    }
  },
  "required": [
    "campaign_id",
    "amount"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.donor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}