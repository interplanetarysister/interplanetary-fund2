{
  "name": "Donation",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Total charged to the donor (the amount they entered). The recipient's gift is amount minus platform_contribution."
    },
    "platform_contribution": {
      "type": "number",
      "default": 0,
      "description": "Portion of the charged amount the donor directed to the platform as an optional 10% contribution. Excluded from the recipient's gift and from withdrawals; retained by the platform."
    },
    "donor_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ]
    },
    "donor_user_id": {
      "type": "string"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "External payment reference (Stripe checkout session id or PayPal order id). Also serves as the idempotency key for provider-confirmed gifts."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied dedup key for manual-confirmation donations (PayPal/Cash App), preventing duplicate ledger entries on retry or double-click."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "cashapp",
        "stripe",
        "other"
      ],
      "default": "paypal",
      "description": "How the supporter sent their gift."
    },
    "payment_verified": {
      "type": "boolean",
      "default": true,
      "description": "True when the payment was confirmed server-side (Stripe webhook, PayPal order capture). False for manual-confirmation gifts (PayPal donate link, Cash App) that have no server-side proof \u2014 these require admin clearing before they can be withdrawn, so a client-supplied amount can never be paid out without verification."
    },
    "is_institutional": {
      "type": "boolean",
      "default": false,
      "description": "True for grant or foundation awards, which require admin clearing before they can be withdrawn."
    },
    "cleared": {
      "type": "boolean",
      "default": false,
      "description": "Admin confirmation that the funds were received and may now be withdrawn. Required for institutional gifts and for unverified (payment_verified=false) manual-confirmation gifts."
    },
    "withdrawal_id": {
      "type": "string",
      "description": "Set to the Withdrawal id once these funds have been cashed out. Null means the funds are still available to withdraw."
    }
  },
  "required": [
    "campaign_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.donor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.donor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}