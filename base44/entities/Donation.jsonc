{
  "name": "Donation",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "The donation amount the supporter entered. Where the processor permits, the processing fee is charged ON TOP (see processing_fee); the total charged to the donor is amount + processing_fee. The recipient's gift is amount minus platform_contribution."
    },
    "platform_contribution": {
      "type": "number",
      "default": 0,
      "description": "Portion of the donation the donor directed to the platform as an optional 10% contribution. Excluded from the recipient's gift and from withdrawals; retained by the platform."
    },
    "processing_fee": {
      "type": "number",
      "default": 0,
      "description": "The payment processor's fee (Stripe/PayPal) charged on top of the donation where the processor permits, identified by payment_method. Retained by the processor, never by Interplanetary Fund. Zero for manual-confirmation methods (PayPal donate link, Cash App) where the processor charges the donor directly on its own site."
    },
    "donor_name": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled"
      ]
    },
    "donor_user_id": {
      "type": "string"
    },
    "canonical_operation_id": {
      "type": "string",
      "description": "Convex providerTransactions operation id for this Base44 display mirror. Canonical financial idempotency and accounting live in Convex; this value is used only to repair/deduplicate the application mirror."
    },
    "stripe_session_id": {
      "type": "string",
      "description": "External payment reference (Stripe checkout session id or PayPal order id). Kept for provider lookup/backward compatibility; canonical idempotency is enforced by Convex."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Client-supplied stable intent key for manual-confirmation donations. The canonical Convex operation, not this Base44 field, is authoritative for deduplication."
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "paypal",
        "cashapp",
        "stripe",
        "other"
      ],
      "default": "paypal",
      "description": "How the supporter sent their gift. Identifies the processor that charged any processing_fee."
    },
    "payment_verified": {
      "type": "boolean",
      "default": true,
      "description": "True when the payment was confirmed server-side. False manual-confirmation gifts are pending mirrors only and must not increase canonical campaign totals or withdrawable ledger value until verified."
    },
    "is_institutional": {
      "type": "boolean",
      "default": false,
      "description": "True for grant or foundation awards, which require admin clearing before they can be withdrawn."
    },
    "cleared": {
      "type": "boolean",
      "default": false,
      "description": "Admin confirmation that the funds were received and may now be withdrawn. Required for institutional gifts and for unverified (payment_verified=false) manual-confirmation gifts."
    },
    "withdrawal_id": {
      "type": "string",
      "description": "Set to the Withdrawal id once these funds have been cashed out. Null means the funds are still available to withdraw."
    }
  },
  "required": [
    "campaign_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.donor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.donor_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}