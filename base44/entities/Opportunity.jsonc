{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "grant",
        "matching_gift",
        "corporate_giving",
        "foundation",
        "business",
        "community",
        "media",
        "event",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "estimated_value": {
      "type": "string"
    },
    "eligibility": {
      "type": "string"
    },
    "required_actions": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "source": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "saved",
        "dismissed"
      ],
      "default": "open"
    }
  },
  "required": [
    "title"
  ]
}