{
  "name": "AdminCredentialVault",
  "type": "object",
  "description": "Service-only credential material for Interplanetary Fund-owned external accounts. Ordinary users, admins, agents, prompts, and UI reads never receive secret_value.",
  "properties": {
    "credential_ref": {
      "type": "string",
      "description": "Opaque reference stored on PlatformOwnedAccount."
    },
    "platform": {
      "type": "string"
    },
    "platform_owned_account_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "Provider login identifier. Service-only."
    },
    "secret_value": {
      "type": "string",
      "description": "Provider password/app-password/sign-in secret. Service-only; never project into responses, logs, prompts, messages, delegation state, or audit detail."
    },
    "allowed_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "invalid",
        "revoked"
      ],
      "default": "active"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_use_status": {
      "type": "string",
      "enum": [
        "unused",
        "success",
        "failed",
        "human_required"
      ],
      "default": "unused"
    }
  },
  "required": [
    "credential_ref",
    "platform",
    "username",
    "secret_value",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}