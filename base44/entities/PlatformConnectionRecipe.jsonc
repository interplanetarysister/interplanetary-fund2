{
  "name": "PlatformConnectionRecipe",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "description": "Stable platform key shared across users."
    },
    "operation": {
      "type": "string",
      "description": "Capability/operation this recipe connects or executes, e.g. connect, read_metrics, publish."
    },
    "recipe_version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proven",
        "probation",
        "stale",
        "disabled"
      ],
      "default": "probation"
    },
    "preferred_transport": {
      "type": "string",
      "enum": [
        "oauth",
        "api",
        "webhook",
        "token",
        "authenticated_browser",
        "public_browser",
        "manual"
      ]
    },
    "fallback_transports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connector_type": {
      "type": "string",
      "description": "Base44 connector type when OAuth/native connector is the proven transport."
    },
    "worker_key": {
      "type": "string",
      "description": "Stable internal worker/adapter identifier; never a user session or credential."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_count": {
      "type": "number",
      "default": 0
    },
    "consecutive_failure_count": {
      "type": "number",
      "default": 0
    },
    "last_success_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_fingerprint": {
      "type": "string",
      "description": "Non-secret provider/config fingerprint used to invalidate a recipe after provider changes."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "transport": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "discovery_state": {
      "type": "string",
      "enum": [
        "unresearched",
        "researched",
        "testing",
        "exhausted",
        "proven"
      ],
      "default": "unresearched",
      "description": "Route-discovery lifecycle. Documentation alone may set researched; only verified successful execution may set proven."
    },
    "candidate_transports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provider-supported candidate routes found during discovery. Candidates are not proven until exercised successfully."
    },
    "blocked_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "transport": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Non-secret routes that failed or were disallowed. A blocked route causes discovery of another provider-permitted route; it is never treated as permission to evade the block."
    },
    "successful_route": {
      "type": "object",
      "description": "Last verified successful IFund route for this platform/operation.",
      "properties": {
        "transport": {
          "type": "string"
        },
        "worker_key": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "recipe_version": {
          "type": "number"
        }
      }
    },
    "research_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "description": "Non-secret official/provider documentation evidence used to discover candidate routes."
    },
    "rediscovery_on_failure": {
      "type": "boolean",
      "default": true,
      "description": "When a proven route stops working, automatically return to route discovery instead of permanently failing the platform."
    }
  },
  "required": [
    "platform",
    "operation",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
