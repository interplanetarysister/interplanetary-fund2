{
  "name": "SupportTicket",
  "type": "object",
  "description": "Private support requests. Tickets are visible to their creator and administrators only.",
  "properties": {
    "user_id": { "type": "string" },
    "name": { "type": "string" },
    "email": { "type": "string" },
    "subject": { "type": "string", "maxLength": 200 },
    "message": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "request_id": { "type": "string", "maxLength": 36, "description": "Caller request UUID, scoped to authenticated user by the submission function. Not a unique database constraint." },
    "status": { "type": "string", "enum": ["open", "closed"], "default": "open" }
  },
  "required": ["user_id", "name", "email", "message"],
  "rls": {
    "read": { "$or": [ { "data.user_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } } ] },
    "create": false,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
