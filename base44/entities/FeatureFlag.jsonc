{
  "name": "FeatureFlag",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "beta",
        "experiment"
      ],
      "default": "global"
    }
  },
  "required": [
    "key"
  ]
}