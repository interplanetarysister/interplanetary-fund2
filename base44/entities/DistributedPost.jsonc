{
  "name": "DistributedPost",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "campaign_title": {
      "type": "string"
    },
    "connection_id": {
      "type": "string",
      "description": "The PlatformConnection this post targets."
    },
    "platform": {
      "type": "string"
    },
    "source_update_id": {
      "type": "string",
      "description": "When this post was generated from a campaign update cross-post, the originating CampaignUpdate id."
    },
    "content": {
      "type": "string",
      "description": "Platform-tailored post text generated by the Distribution Engine."
    },
    "hashtags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "scheduled",
        "publishing",
        "published",
        "failed"
      ],
      "default": "draft"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "external_post_url": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "publish_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the durable pre-provider publication claim. Stale claims are quarantined rather than automatically republished."
    },
    "publish_claim_token": {
      "type": "string",
      "description": "Opaque correlation token for the current publication claim; never sent to external providers."
    }
  },
  "required": [
    "campaign_id",
    "platform",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
