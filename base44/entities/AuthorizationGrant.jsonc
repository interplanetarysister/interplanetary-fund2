{
  "name": "AuthorizationGrant",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "The agent or service identity granted the right to act."
    },
    "user_id": {
      "type": "string",
      "description": "The grantor — the user authorizing the agent to act on their behalf (OBO)."
    },
    "platform": {
      "type": "string",
      "description": "The platform or capability this grant covers (e.g. email, social_publish)."
    },
    "purpose": {
      "type": "string",
      "description": "Plain-language reason for the delegation."
    },
    "scope": {
      "type": "string",
      "description": "Granted action scope, e.g. 'read_mail_thread', 'publish_draft'."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional expiry; null means no expiry."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_reason": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "execution_model": {
      "type": "string",
      "enum": [
        "user_directed_extension",
        "legacy_agent"
      ],
      "default": "user_directed_extension",
      "description": "How IFund interprets execution under this grant. user_directed_extension means software executes the principal user's command/standing OBO authority within scope."
    },
    "principal_user_id": {
      "type": "string",
      "description": "Explicit principal whose command/standing authorization is being executed. Normally equal to user_id."
    },
    "command_source": {
      "type": "string",
      "enum": [
        "direct_user_command",
        "standing_obo_instruction"
      ],
      "description": "Whether execution was invoked by a current user command or an already-granted standing OBO instruction."
    }
  },
  "required": [
    "agent_name",
    "user_id",
    "platform",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
