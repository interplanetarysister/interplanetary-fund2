{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Convex Sync",
  "description": "Auto-syncs agents, campaigns, treasury, and protocol reports from the Convex mission backend into Base44 entities every 15 minutes so the Ops Center stays fresh without a manual Sync Now.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "convex_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncFromConvex",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync from Convex",
            "description": "Pull agents, campaigns, treasury, reports"
          }
        }
      }
    ]
  }
}