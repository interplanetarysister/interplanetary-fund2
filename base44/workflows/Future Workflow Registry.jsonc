{
  "name": "Future Workflow Registry",
  "description": "Event-driven scaffold for future feature implementation. When a FeatureDiscovery record is created or updated, the existing feature processor evaluates it. This defines a Base44 workflow path without inventing unsupported feature execution.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "FeatureDiscovery",
      "events": [
        "create",
        "update"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "future_workflow_registry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_feature_discovery": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processFeatureDiscovery",
            "args": {
              "feature_discovery_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process future feature",
            "description": "Route future feature work through the existing feature-discovery processor"
          }
        }
      }
    ]
  }
}