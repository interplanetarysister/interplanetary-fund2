{
  "name": "Future Workflow Registry",
  "description": "Event-driven workflow scaffold for future feature implementation. When a FeatureDiscovery record is created or updated, the existing discovery processor evaluates it. This keeps future feature intake on a defined Base44 workflow path without inventing unsupported feature execution.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        {
          "entity_name": "FeatureDiscovery",
          "event_types": [
            "create",
            "update"
          ]
        }
      ],
      "schedule_mode": null,
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": null,
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "future_workflow_registry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_feature_discovery": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processFeatureDiscovery",
            "args": {
              "feature_discovery_id": "${ .trigger.record.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process future feature",
            "description": "Route discovered future feature work through the existing feature-discovery processor"
          }
        }
      }
    ]
  }
}