{
  "name": "Future Workflow Registry",
  "description": "Pre-built future-feature workflow scaffold. Campaign updates enter the existing feature-discovery engine, which can surface newly implemented capabilities without creating a parallel scheduler or unsupported execution path.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "entity_name": "Campaign",
      "events": [
        "update"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "future_workflow_registry",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "discover_future_features": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "discoverFeatures",
            "args": {
              "user_id": "${ .trigger.data.created_by_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh feature discovery",
            "description": "Evaluate the campaign owner for newly available platform features"
          }
        }
      }
    ]
  }
}