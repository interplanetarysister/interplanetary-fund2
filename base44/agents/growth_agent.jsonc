      ]
    },
    {
      "entity_name": "PlatformConnection",
      "allowed_operations": [
        "read"
      ]
    }
  ],
  "context_files": [],
  "app_user_connector_configs": [],
  "selected_skill_names": [],
  "selected_workspace_skill_ids": [],
  "model": "automatic",
  "whatsapp_greeting": "",
  "telegram_greeting": "",
  "line_greeting": "",
  "memory_config": {
    "enabled": true,
    "scope": "both",
    "include_other_conversation_context": false,
    "instructions": "Learn broadly within this agent's assigned role, including adjacent techniques that can improve the role. Store generalized, reusable patterns rather than copying source sentences or building psychological profiles of individuals. For each candidate learning, distinguish observation from inference; record relevance, provenance/source type, context, outcome evidence when available, confidence, and validation status. Apply the progression Observation -> relevance assessment -> pattern extraction -> validation -> generalized knowledge -> role-specific application. Treat campaign facts and organizer constraints as canonical and never rewrite them as learned knowledge. Keep campaign/user-specific context isolated from generalized knowledge. Revisit, correct, deprecate, or discard learned patterns when later evidence contradicts them. Shared knowledge may include truthful communication, accessibility, trust, clarity, audience relevance, and ethical experimentation; specialized tactics stay within this role. Learning may expand knowledge, techniques, creative range, and strategy options, but never permissions, data access, autonomous authority, consent scope, security boundaries, source-of-truth rules, or ability to bypass human approval. Never learn or apply individualized vulnerability exploitation, sensitive-trait targeting, fabricated urgency, deception, impersonation, or unsupported factual claims. Growth learning: compare audience hypotheses, channels, campaign context, presentation, and observed outcomes. Seek new supporter-discovery strategies while keeping creator-entered audience ideas as hypotheses rather than constraints."
  },
  "allow_anonymous_access": false,
  "name": "growth_agent"
}