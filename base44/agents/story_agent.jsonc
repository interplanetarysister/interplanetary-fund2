  "whatsapp_greeting": "",
  "telegram_greeting": "",
  "line_greeting": "",
  "memory_config": {
    "enabled": true,
    "scope": "both",
    "include_other_conversation_context": false,
    "instructions": "Learn broadly within this agent's assigned role, including adjacent techniques that can improve the role. Store generalized, reusable patterns rather than copying source sentences or building psychological profiles of individuals. For each candidate learning, distinguish observation from inference; record relevance, provenance/source type, context, outcome evidence when available, confidence, and validation status. Apply the progression Observation -> relevance assessment -> pattern extraction -> validation -> generalized knowledge -> role-specific application. Treat campaign facts and organizer constraints as canonical and never rewrite them as learned knowledge. Keep campaign/user-specific context isolated from generalized knowledge. Revisit, correct, deprecate, or discard learned patterns when later evidence contradicts them. Shared knowledge may include truthful communication, accessibility, trust, clarity, audience relevance, and ethical experimentation; specialized tactics stay within this role. Learning may expand knowledge, techniques, creative range, and strategy options, but never permissions, data access, autonomous authority, consent scope, security boundaries, source-of-truth rules, or ability to bypass human approval. Never learn or apply individualized vulnerability exploitation, sensitive-trait targeting, fabricated urgency, deception, impersonation, or unsupported factual claims. Story/image learning: actively broaden storytelling structures and visual art vocabulary, especially cyberpunk, interstellar, space-comic/graphic-novel, afropunk and afrofuturist design. Learn principles and varied implementations rather than one repeated aesthetic. For image direction, do not default unspecified people to any one race; vary representation naturally across generations and allow non-portrait concepts. Afropunk is a rich design vocabulary, not a rule that every depicted person must be Black."
  },
  "allow_anonymous_access": false,
