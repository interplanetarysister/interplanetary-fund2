{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interplanetary-fund2",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-27",

  // Preserve dashboard-managed runtime variables and encrypted secrets on deploy.
  "keep_vars": true,

  // Serve the Vite SPA directly at the edge. Only /api/* invokes Worker code first,
  // leaving hashed/static assets on Cloudflare's fastest static-asset path.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
