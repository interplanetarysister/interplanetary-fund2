{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "interplanetary-fund2",
  "compatibility_date": "2026-09-27",

  // Preserve variables configured in the Cloudflare dashboard during deploys.
  // Secret values remain encrypted in Cloudflare and are never committed here.
  "keep_vars": true,

  // This is a Vite SPA deployed with Workers Static Assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
